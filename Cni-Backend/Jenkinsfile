pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins: agent
spec:
  serviceAccountName: jenkins-agent
  containers:
  - name: dotnet
    image: mcr.microsoft.com/dotnet/sdk:9.0
    command: ['cat']
    tty: true
    env:
    - name: ConnectionStrings__BackendDb
      value: "Server=localhost;Port=5432;User ID=postgres;Password=test;Database=DermsDb_Test;Pooling=true;"
  - name: docker
    image: docker:27.0-cli
    command: ['cat']
    tty: true
    volumeMounts:
    - name: docker-sock
      mountPath: /var/run/docker.sock
  - name: kubectl
    image: alpine/k8s:1.28.3
    command: ['cat']
    tty: true
  - name: postgres
    image: postgres:15
    env:
    - name: POSTGRES_USER
      value: "postgres"
    - name: POSTGRES_PASSWORD
      value: "test"
    - name: POSTGRES_DB
      value: "DermsDb_Test"
    ports:
    - containerPort: 5432
  volumes:
  - name: docker-sock
    hostPath:
      path: /var/run/docker.sock
            """
        }
    }

    environment {
        DOCKER_REGISTRY = 'REDACTED_HOST:30500'
        DOCKER_IMAGE_NAME = 'cni-backend'
        GIT_COMMIT_SHORT = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
        BUILD_TAG = "${env.BRANCH_NAME}-${env.BUILD_NUMBER}-${GIT_COMMIT_SHORT}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                container('dotnet') {
                    sh """
                        dotnet restore
                        dotnet build -c Release --no-restore
                        dotnet test -c Release --no-build --verbosity normal || true
                    """
                }
            }
        }

        // ========== DEV ==========
        stage('Docker Build - Dev') {
            when { branch 'dev' }
            steps {
                container('docker') {
                    sh """
                        docker build -t ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:dev-${BUILD_TAG} \
                            -f ./Dockerfile .
                        docker tag ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:dev-${BUILD_TAG} \
                            ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:dev-latest
                    """
                }
            }
        }

        stage('Docker Push - Dev') {
            when { branch 'dev' }
            steps {
                container('docker') {
                    sh """
                        docker push ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:dev-${BUILD_TAG}
                        docker push ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:dev-latest
                    """
                }
            }
        }

        stage('Deploy - Dev') {
            when { branch 'dev' }
            steps {
                container('kubectl') {
                    sh """
                        kubectl set image deployment/cni-backend \
                            backend=${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:dev-latest \
                            -n cni-dev
                        kubectl rollout restart deployment/cni-backend -n cni-dev
                        kubectl rollout status deployment/cni-backend \
                            -n cni-dev --timeout=5m
                    """
                }
            }
            post {
                success {
                    echo "Deployed to DEV: http://cni-api-dev.oklidis.com.tr"
                }
            }
        }

        // ========== STAGE ==========
        stage('Docker Build - Stage') {
            when { branch 'stg' }
            steps {
                container('docker') {
                    sh """
                        docker build -t ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:stg-${BUILD_TAG} \
                            -f ./Dockerfile .
                        docker tag ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:stg-${BUILD_TAG} \
                            ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:stg-latest
                    """
                }
            }
        }

        stage('Docker Push - Stage') {
            when { branch 'stg' }
            steps {
                container('docker') {
                    sh """
                        docker push ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:stg-${BUILD_TAG}
                        docker push ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:stg-latest
                    """
                }
            }
        }

        stage('Deploy - Stage') {
            when { branch 'stg' }
            steps {
                container('kubectl') {
                    sh """
                        kubectl set image deployment/cni-backend \
                            backend=${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:stg-latest \
                            -n cni-stg
                        kubectl rollout restart deployment/cni-backend -n cni-stg
                        kubectl rollout status deployment/cni-backend \
                            -n cni-stg --timeout=5m
                    """
                }
            }
            post {
                success {
                    echo "Deployed to STAGE: http://cni-api-stg.oklidis.com.tr"
                }
            }
        }
    }

    post {
        always {
            catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                deleteDir()
            }
        }
        success { echo "Pipeline completed: ${BUILD_TAG}" }
        failure { echo "Pipeline failed!" }
    }
}
