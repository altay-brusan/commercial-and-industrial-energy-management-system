pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins: agent
spec:
  serviceAccountName: jenkins-agent
  containers:
  - name: dotnet
    image: mcr.microsoft.com/dotnet/sdk:9.0
    command: ['cat']
    tty: true
  - name: docker
    image: docker:27.0-cli
    command: ['cat']
    tty: true
    volumeMounts:
    - name: docker-sock
      mountPath: /var/run/docker.sock
  - name: kubectl
    image: alpine/k8s:1.28.3
    command: ['cat']
    tty: true
  volumes:
  - name: docker-sock
    hostPath:
      path: /var/run/docker.sock
            """
        }
    }

    environment {
        DOCKER_REGISTRY = 'REDACTED_HOST:30500'
        DOCKER_IMAGE_NAME = 'cni-backend'
        GIT_COMMIT_SHORT = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
        ENV_NAME = "${env.BRANCH_NAME == 'stg' ? 'stg' : 'dev'}"
        K8S_NAMESPACE = "cni-${ENV_NAME}"
        BUILD_TAG = "${ENV_NAME}-${env.BUILD_NUMBER}-${GIT_COMMIT_SHORT}"
        IMAGE_LATEST = "${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:${ENV_NAME}-latest"
        DEPLOY_URL = "${ENV_NAME == 'stg' ? 'cni-api-stg.oklidis.com.tr' : 'cni-api-dev.oklidis.com.tr'}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                container('dotnet') {
                    sh """
                        dotnet restore src/Web/Web.csproj
                        dotnet build src/Web/Web.csproj -c Release --no-restore
                        dotnet test --filter "FullyQualifiedName~UnitTests" -c Release --verbosity normal || true
                    """
                }
            }
        }

        stage('Docker Build') {
            steps {
                container('docker') {
                    sh """
                        docker build -t ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:${BUILD_TAG} \
                            -f ./Dockerfile .
                        docker tag ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:${BUILD_TAG} \
                            ${IMAGE_LATEST}
                    """
                }
            }
        }

        stage('Docker Push') {
            steps {
                container('docker') {
                    sh """
                        docker push ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:${BUILD_TAG}
                        docker push ${IMAGE_LATEST}
                    """
                }
            }
        }

        stage('Deploy') {
            steps {
                container('kubectl') {
                    sh """
                        kubectl set image deployment/cni-backend \
                            backend=${IMAGE_LATEST} \
                            -n ${K8S_NAMESPACE}
                        kubectl rollout restart deployment/cni-backend -n ${K8S_NAMESPACE}
                        kubectl rollout status deployment/cni-backend \
                            -n ${K8S_NAMESPACE} --timeout=5m
                    """
                }
            }
            post {
                success {
                    echo "Deployed to ${ENV_NAME.toUpperCase()}: http://${DEPLOY_URL}"
                }
            }
        }
    }

    post {
        always {
            catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                deleteDir()
            }
        }
        success { echo "Pipeline completed: ${BUILD_TAG}" }
        failure { echo "Pipeline failed!" }
    }
}
