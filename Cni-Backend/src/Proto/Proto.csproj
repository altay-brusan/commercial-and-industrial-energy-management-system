<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Commands\command_system.proto" />
    <None Remove="Streams\stream_bess.proto" />
    <None Remove="Streams\stream_generator.proto" />
    <None Remove="Streams\stream_pcs.proto" />
    <None Remove="Streams\stream_smartmeter.proto" />
    <None Remove="Streams\stream_solar.proto" />
    <None Remove="Streams\stream_system.proto" />
    <None Remove="Streams\types_generic.proto" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Events\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Commands\command_system.proto" GrpcServices="Client" />
    <Protobuf Include="Streams\stream_bess.proto" GrpcServices="Client" ProtoRoot="Streams"  />
    <Protobuf Include="Streams\stream_pcs.proto" GrpcServices="Client" ProtoRoot="Streams" />
    <Protobuf Include="Streams\stream_smartmeter.proto" GrpcServices="Client" ProtoRoot="Streams" />
    <Protobuf Include="Streams\stream_solar.proto" GrpcServices="Client" ProtoRoot="Streams" />
    <Protobuf Include="Streams\stream_system.proto" GrpcServices="Client" ProtoRoot="Streams" />
    <Protobuf Include="Streams\types_generic.proto" GrpcServices="None" />
  </ItemGroup>

</Project>
