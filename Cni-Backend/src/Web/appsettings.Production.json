{
  "ConnectionStrings": {
    "BackendDb": "Host=postgres-prod;Port=5432;Database=cni_prod;Username=app_user;Password=***REMOVED***"
  },
  "JwtSettings": {
    "Secret": "***REMOVED***",
    "Issuer": "DERMS-Backend",
    "Audience": "DERMS-Frontend",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "MqttSettings": {
    "Host": "REDACTED_HOST",
    "Port": 31884,
    "Username": "admin",
    "Password": "***REMOVED***",
    "ClientId": "cni-backend-prod",
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.PostgreSQL" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "PostgreSQL",
        "Args": {
          "connectionString": "Host=postgres-prod;Port=5432;Database=cni_prod;Username=app_user;Password=***REMOVED***",
          "tableName": "logs",
          "needAutoCreateTable": true
        }
      },
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "MyCleanArchApp"
    }
  }
}
