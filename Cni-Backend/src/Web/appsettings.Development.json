{
  "ConnectionStrings": {
    "BackendDb": "Host=localhost;Port=5432;Database=DermsDb;Username=postgres;Password=admin"
  },
  "JwtSettings": {
    "Secret": "DevSuperSecretKeyThatIsAtLeast32BytesLong!!2024",
    "Issuer": "DERMS-Backend",
    "Audience": "DERMS-Frontend",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore.SpaProxy": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.PostgreSQL" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "PostgreSQL",
        "Args": {
          "connectionString": "Host=localhost;Port=5432;Database=DermsDb;Username=postgres;Password=admin",
          "tableName": "logs",
          "needAutoCreateTable": true
        }
      },
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "MyCleanArchApp"
    }
  }
}
