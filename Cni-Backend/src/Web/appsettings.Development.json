{
  "ConnectionStrings": {
    "BackendDb": "Host=REDACTED_HOST;Port=30434;Database=cni_dev;Username=app_user;Password=***REMOVED***;Search Path=public"
  },
  "JwtSettings": {
    "Secret": "***REMOVED***",
    "Issuer": "DERMS-Backend",
    "Audience": "DERMS-Frontend",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "IngestSettings": {
    "ApiKey": "***REMOVED***"
  },
  "MqttSettings": {
    "Host": "REDACTED_HOST",
    "Port": 31883,
    "Username": "admin",
    "Password": "***REMOVED***",
    "ClientId": "cni-backend-dev",
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore.SpaProxy": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.PostgreSQL" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "PostgreSQL",
        "Args": {
          "connectionString": "Host=REDACTED_HOST;Port=30434;Database=cni_dev;Username=app_user;Password=***REMOVED***;Search Path=public",
          "tableName": "logs",
          "needAutoCreateTable": true
        }
      },
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "MyCleanArchApp"
    }
  }
}
