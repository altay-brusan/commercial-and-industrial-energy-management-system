<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Protos\command_system.proto" />
    <None Remove="Protos\event_system.proto" />
    <None Remove="Protos\stream_bess.proto" />
    <None Remove="Protos\stream_generator.proto" />
    <None Remove="Protos\stream_pcs.proto" />
    <None Remove="Protos\stream_smartmeter.proto" />
    <None Remove="Protos\stream_solar.proto" />
    <None Remove="Protos\stream_system.proto" />
    <None Remove="Protos\types_generic.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.57.0" />
    <PackageReference Include="Grpc.Tools" Version="2.70.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
	  <Protobuf Include="Protos\command_system.proto" GrpcServices="Server" ProtoRoot="Protos" />
	  <Protobuf Include="Protos\event_system.proto" GrpcServices="Server" ProtoRoot="Protos" />
	  <Protobuf Include="Protos\stream_bess.proto" GrpcServices="Server" ProtoRoot="Protos" />
	  <Protobuf Include="Protos\stream_generator.proto" GrpcServices="Server" ProtoRoot="Protos" />
	  <Protobuf Include="Protos\stream_pcs.proto" GrpcServices="Server" ProtoRoot="Protos" />
	  <Protobuf Include="Protos\stream_smartmeter.proto" GrpcServices="Server" ProtoRoot="Protos" />
	  <Protobuf Include="Protos\stream_solar.proto" GrpcServices="Server" ProtoRoot="Protos" />
	  <Protobuf Include="Protos\stream_system.proto" GrpcServices="Server" ProtoRoot="Protos" />

	  <!-- types_generic.proto (gRPC servis içermiyor!) -->
	  <Protobuf Include="Protos\types_generic.proto" GrpcServices="None" ProtoRoot="Protos" />
  </ItemGroup>

</Project>
